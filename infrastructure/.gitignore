# Local .terraform directories
**/.terraform/*

# .tfstate files (ignore!)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Ignore any .tfvars files that contain sensitive information
*.tfvars
*.auto.tfvars

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json